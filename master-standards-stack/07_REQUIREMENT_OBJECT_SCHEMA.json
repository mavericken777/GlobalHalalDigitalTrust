{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IQ300 Master Standards Stack Requirement Object",
  "type": "object",
  "required": ["RequirementID", "Instrument", "Clause", "RequirementSummary", "Applicability", "ControlObjective", "VerificationStatus"],
  "properties": {
    "RequirementID": {"type": "string"},
    "Authority": {"type": "string"},
    "Instrument": {"type": "string"},
    "InstrumentType": {"type": "string"},
    "Edition": {"type": ["string", "null"]},
    "Confirmation": {"type": ["string", "null"]},
    "EffectiveDate": {"type": ["string", "null"]},
    "Supersedes": {"type": ["string", "null"]},
    "Clause": {"type": "string"},
    "RequirementSummary": {"type": "string"},
    "Applicability": {"type": "array", "items": {"type": "string"}},
    "Risk": {"type": ["string", "null"]},
    "ControlObjective": {"type": "string"},
    "Control": {"type": ["string", "null"]},
    "HCP": {"type": "boolean"},
    "PhysicalObject": {"type": "array", "items": {"type": "string"}},
    "Evidence": {"type": "array", "items": {"type": "string"}},
    "Test": {"type": ["string", "null"]},
    "ResponsibleActor": {"type": ["string", "null"]},
    "Verifier": {"type": ["string", "null"]},
    "AuthorityGate": {"type": "boolean"},
    "Event": {"type": ["string", "null"]},
    "FailureState": {"type": "array", "items": {"type": "string"}},
    "CorrectiveAction": {"type": ["string", "null"]},
    "ReVerification": {"type": ["string", "null"]},
    "TrustStateEffect": {"type": ["string", "null"]},
    "Source": {"type": ["string", "null"]},
    "VerificationStatus": {"type": "string", "enum": ["SOURCE-DERIVED", "PRIMARY-SUPPLIED", "AUTHORITY-CONFIRMED", "RESEARCH-HOLD"]}
  }
}
