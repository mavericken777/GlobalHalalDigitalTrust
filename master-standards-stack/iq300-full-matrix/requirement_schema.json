{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IQ300 Requirement Object",
  "type": "object",
  "required": ["requirement_id","standard","edition","clause","requirement_intent","applicability","control_object","hcp","evidence_classes","audit_test","authority_gate","trust_state_effect"],
  "properties": {
    "requirement_id": {"type": "string"},
    "standard": {"type": "string"},
    "sector": {"type": "string"},
    "edition": {"type": "string"},
    "status": {"type": "string"},
    "clause": {"type": "string"},
    "clause_title": {"type": "string"},
    "hierarchy_level": {"type": "integer", "minimum": 1},
    "source_pdf": {"type": "string"},
    "source_pdf_page_estimate": {"type": ["integer","null"]},
    "source_basis": {"type": "string"},
    "requirement_intent": {"type": "string"},
    "applicability": {"type": "string"},
    "control_object": {"type": "string"},
    "control_owner": {"type": "string"},
    "hcp": {"type": "string"},
    "risk_class": {"type": "string"},
    "control_pattern": {"type": "string"},
    "evidence_classes": {"type": "array", "items": {"type": "string"}},
    "audit_test": {"type": "array", "items": {"type": "string"}},
    "authority_gate": {"type": "string"},
    "digital_events": {"type": "array", "items": {"type": "string"}},
    "failure_states": {"type": "array", "items": {"type": "string"}},
    "corrective_action": {"type": "string"},
    "reverification": {"type": "string"},
    "trust_state_effect": {"type": "string"},
    "raw_clause_context_for_audit_development": {"type": "string"}
  }
}
